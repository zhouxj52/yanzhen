# Copy to .env. Never commit real credentials.
# Foundation-only development: model calls stay disabled until explicitly enabled.
YZ_ENABLE_MODEL=0
YZ_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
YZ_LLM_MODEL=Qwen3-Coder-30B-A3B-Instruct
YZ_LLM_API_KEY=
# Optional DeepSeek. Enable YZ_ENABLE_MODEL=1 only when you want real model calls.
# Official docs checked 2026-10-25; model availability is determined by your account.
YZ_DEEPSEEK_BASE_URL=https://api.deepseek.com
YZ_DEEPSEEK_MODEL=deepseek-flash
YZ_DEEPSEEK_API_KEY=
# For a trusted local inference server only; never use this to bypass a remote key.
YZ_LLM_ALLOW_NO_KEY=0
YZ_PORT=8765
