# Copy to .env. Never commit real credentials.
# Foundation-only development: model calls stay disabled until explicitly enabled.
YZ_ENABLE_MODEL=0
YZ_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
YZ_LLM_MODEL=Qwen3-Coder-30B-A3B-Instruct
YZ_LLM_API_KEY=
# Optional DeepSeek. Enable YZ_ENABLE_MODEL=1 only when you want real model calls.
# Official docs checked 2026-10-25; model availability is determined by your account.
YZ_DEEPSEEK_BASE_URL=https://api.deepseek.com
YZ_DEEPSEEK_MODEL=deepseek-flash
YZ_DEEPSEEK_API_KEY=
# For a trusted local inference server only; never use this to bypass a remote key.
YZ_LLM_ALLOW_NO_KEY=0
YZ_PORT=8765
# Generic VerifyAgent: exact local/test origins. Empty means network access is denied.
YZ_VERIFY_ALLOWED_ORIGINS=
# Identity values remain server-side; target configuration references only these names.
YZ_VERIFY_SECRET_ALICE=
YZ_VERIFY_SECRET_BOB=
# Optional isolated artifact directory; export before process startup if overriding.
# YZ_ARTIFACTS_DIR=D:/openjiuwen/.artifacts/verifyagent-service
# Optional JiuwenSwarm 0.2.3 bounded facade host. Agent ID is a routing label.
YZ_SWARM_WS_URL=
YZ_SWARM_AGENT_ID=
YZ_SWARM_PLANNING_ONLY=0
YZ_SWARM_LOCAL_RUNTIME=0
# A separate local runtime credential, never your DeepSeek key. Generate locally.
YZ_SWARM_PROXY_KEY=
# Optional persistent paid-call cap. Set verified CNY prices for the exact model.
YZ_VERIFY_BUDGET_CNY=0
YZ_VERIFY_PRICED_MODEL=
YZ_VERIFY_INPUT_CNY_PER_MILLION=
YZ_VERIFY_OUTPUT_CNY_PER_MILLION=
YZ_VERIFY_MAX_PAID_CALLS=60
# Optional cost estimates use your own provider rates; unset means unknown.
# YZ_VERIFY_INPUT_USD_PER_MILLION=
# YZ_VERIFY_OUTPUT_USD_PER_MILLION=
